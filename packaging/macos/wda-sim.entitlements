<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundled WebDriverAgent simulator runner. Notarization wants the
     hardened runtime, which drops DYLD_* variables; a simulator process
     can't start without DYLD_ROOT_PATH. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
